{
  "ssg": "jekyll",
  "mode": "hosted",
  "build_configuration": {
    "hugoVersion": "0.157.0",
    "rubyVersion": "3.4.8",
    "nodeVersion": "22",
    "denoVersion": "2.7.1",
    "environment_variables": [
      {
        "key": "JEKYLL_ENV",
        "value": "production"
      }
    ],
    "preserved_paths": ".jekyll-cache/,.jekyll-metadata/,.bundle-cache/",
    "jekyll_environment": "staging",
    "source": "",
    "limit_posts": "",
    "drafts": false,
    "unpublished": false,
    "future": false,
    "lsi": false,
    "profile": false,
    "verbose": false,
    "quiet": false,
    "trace": false,
    "use_local_bundle": true,
    "enable_bundle_cache": true,
    "autosync_gemlock": false
  }
}